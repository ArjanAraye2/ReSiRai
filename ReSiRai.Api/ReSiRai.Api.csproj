<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Executable icon: used by the service host and by the shortcuts the
         installer creates, so ReSiRai never shows the default .NET icon. -->
    <ApplicationIcon>wwwroot\images\resirai.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- OCR language data (Persian + English + orientation) travels with the app,
         so the keyless pipeline can read scanned pages on any machine. -->
    <Content Include="Tools\tessdata\*.traineddata" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
